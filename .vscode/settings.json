// Place your settings in this file to overwrite default and user settings.
{
    "files.exclude": {
        "_site/": true,
        "support/": true
    },
    "cSpell.words": [
        "Beatsy"
    ],
    "markdown.copyFiles.destination": {
        "/_posts/**/*": "/content/${documentBaseName}/${fileName}"
    },
    "markdown.editor.filePaste.videoSnippet": "{% include video.html file=\"${src}\" poster=\"\" description=\"\" %}"
}